warning: RhAttack/P4Tail.lean:44:0: The module doc-string for a file should be the first command after the imports.
Please, add a module doc-string before `/-- On [n, n+1]: B̂₂ = the frozen polynomial. -/
lemma B2_of_Icc_int (n : ℕ) {x : ℝ} (hx : x ∈ Set.Icc (n : ℝ) (n + 1 : ℝ)) : B2 x = (x - n) ^ 2 - (x - n) + 1 / 6 :=
  by
  unfold B2
  by_cases htop : x = (n + 1 : ℝ)
  · rw [htop]
    have hfl : (⌊(n + 1 : ℝ)⌋₊ : ℕ) = n + 1 :=
      (Nat.floor_eq_iff (ha := by positivity)).mpr
        ⟨by norm_cast, by
          norm_cast
          linarith⟩
    rw [hfl]
    norm_num
  · have hn : (⌊x⌋₊ : ℝ) = (n : ℝ) := by
      norm_cast
      rw [Nat.floor_eq_iff (by linarith [show (0 : ℝ) ≤ x from le_trans (Nat.cast_nonneg n) hx.1])]
      constructor
      · linarith [hx.1]
      · exact lt_of_le_of_ne hx.2 htop
    rw [hn]`.

