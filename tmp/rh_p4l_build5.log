warning: RhAttack/P4Tail.lean:44:0: The module doc-string for a file should be the first command after the imports.
Please, add a module doc-string before `/-- |B̂₂(x)| ≤ 1/6. -/
lemma abs_B2_le {x : ℝ} (hx : 0 ≤ x) : |B2 x| ≤ 1 / 6 :=
  by
  unfold B2
  set v := (x - ⌊x⌋₊ : ℝ) with hv
  have hv0 : 0 ≤ v := by grind [Nat.floor_le hx]
  have hv1 : v ≤ 1 := by grind [Nat.lt_succ_floor x]
  have hrew : (x - ⌊x⌋₊ : ℝ) ^ 2 - (x - ⌊x⌋₊) + 1 / 6 = v ^ 2 - v + 1 / 6 := by rfl
  have htop : v ^ 2 - v + 1 / 6 ≤ 1 / 6 := by nlinarith [hv0, hv1]
  have hbot : -(1 / 6 : ℝ) ≤ v ^ 2 - v + 1 / 6 :=
    by
    have hsq : v ^ 2 - v + 1 / 6 = (v - 1 / 2) ^ 2 - 1 / 12 := by ring
    nlinarith [hsq, sq_nonneg (v - 1 / 2)]
  simpa only [← hrew] using abs_le.mpr ⟨hbot, htop⟩`.

